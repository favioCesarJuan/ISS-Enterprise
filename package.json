{
  "name": "iss-enterprise",
  "version": "2.1.0",
  "description": "Intelligent Stack Scaffolding for Enterprise (ISS-Enterprise): Multi-stack governance & scaffolding CLI. Detects project archetypes, configures mixed model fleets, compacts skills, and deploys deterministic model hooks with standard, naval, and private local themes.",
  "main": "src/cli.js",
  "types": "./types/index.d.ts",
  "type": "module",
  "bin": {
    "iss-enterprise": "./bin/iss.js",
    "iss": "./bin/iss.js"
  },
  "packageManager": "pnpm@9.0.0",
  "files": [
    "bin",
    "src",
    "types",
    ".agents",
    "examples",
    "README.md",
    "README.es.md",
    "MANUAL.md",
    "MANUAL.es.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/iss.js",
    "apply": "node ./bin/iss.js apply",
    "engage": "node ./bin/iss.js engage",
    "inspect": "node ./bin/iss.js inspect",
    "doctor": "node ./bin/iss.js doctor",
    "audit": "node ./bin/iss.js doctor",
    "demo": "node ./examples/quickstart-demo.js",
    "test": "node ./test/suite.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "cli",
    "scaffolding",
    "iss-enterprise",
    "claude",
    "deepseek",
    "qwen",
    "gemini",
    "ollama",
    "model-hooks",
    "knowledge-graph",
    "rag",
    "astro",
    "monorepo"
  ],
  "author": "Favio Cesar Juan <faviocjuan@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
